+#ifdef IPS3_IOS
+// Ips3: the iOS frontend chooses every directory and exports it before the core is loaded.
+// HOME-derived defaults would land in the sandbox too, but under LiveContainer the process
+// HOME and executable belong to the host app, not to Ips3.
+static std::string ips3_env_dir(const char* name)
+{
+	const char* value = ::getenv(name);
