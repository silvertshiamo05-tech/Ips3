diff --git a/Utilities/Thread.cpp b/Utilities/Thread.cpp
index ee0cfbbd9..c7ff8eb7d 100644
--- a/Utilities/Thread.cpp
+++ b/Utilities/Thread.cpp
@@ -3211,6 +3211,23 @@ static void signal_handler(int sig, siginfo_t* info, void* uct) noexcept
 {
 	ucontext_t* context = static_cast<ucontext_t*>(uct);
 
+#if defined(RPCS3_IOS_VM) && defined(ARCH_ARM64)
+	// Ips3: JIT pages on iOS are W^X and flipped on demand (utils::ios_jit_handle_fault). This
+	// is the hot path for every first execution of freshly generated code, so it runs before
+	// anything else and touches nothing but the page in question.
+	{
+		const auto reason = aarch64::decode_fault_reason(context);
+		const bool is_exec = reason == aarch64::fault_reason::instruction_execute ||
+			(reason == aarch64::fault_reason::undefined && uptr(info->si_addr) == uptr(RIP(context)));
+		const bool is_write = reason == aarch64::fault_reason::data_write;
+
+		if ((is_exec || is_write) && utils::ios_jit_handle_fault(info->si_addr, is_exec, is_write))
+		{
+			return;
+		}
+	}
+#endif
+
 #ifdef __ANDROID__
 	// Not our fault: hand it to whoever we displaced.
 	//
@@ -4749,6 +4766,15 @@ void thread_ctrl::silent_exit() noexcept
 }
 
 
