+// Ips3: rectangle lists on hosts without geometry shaders.
+//
+// Xenos rectangle lists give 3 vertices per rectangle; the fourth is the
+// third vertex mirrored across the longest edge (see the kRectangleList
+// geometry shader in VulkanPipelineCache). Without geometry shaders the
+// primitive processor draws each rectangle as a 4-vertex triangle strip, and
+// every host vertex runs the guest vertex shader once for each of the 3 guest
+// vertices (the passes), keeping their outputs, and then outputs its own
+// corner: one of the 3, or the mirrored fourth.
+
+bool SpirvShaderTranslator::IsRectangleListExpansion() const {
+  return IsSpirvVertexShader() &&
+         GetSpirvShaderModification().vertex.host_vertex_shader_type ==
+             Shader::HostVertexShaderType::kRectangleListAsTriangleStrip;
+}
+
+void SpirvShaderTranslator::OpenRectangleListPasses() {
+  spv::Id const_uint_3 = builder_->makeUintConstant(3);
+  var_main_rect_pass_ = builder_->createVariable(
+      spv::NoPrecision, spv::StorageClassFunction, type_uint_,
+      "xe_var_rect_pass", const_uint_0_);
+  spv::Id type_float4_x3 = builder_->makeArrayType(type_float4_, const_uint_3, 0);
+  var_main_rect_positions_ = builder_->createVariable(
+      spv::NoPrecision, spv::StorageClassFunction, type_float4_x3,
+      "xe_var_rect_positions");
+  uint32_t interpolators_remaining = GetModificationInterpolatorMask();
+  uint32_t interpolator_index;
+  while (xe::bit_scan_forward(interpolators_remaining, &interpolator_index)) {
+    interpolators_remaining &= ~(UINT32_C(1) << interpolator_index);
+    var_main_rect_interpolators_[interpolator_index] = builder_->createVariable(
+        spv::NoPrecision, spv::StorageClassFunction, type_float4_x3,
+        fmt::format("xe_var_rect_interpolator_{}", interpolator_index).c_str());
+  }
+  if (rect_clip_distance_count_) {
+    var_main_rect_clip_distances_ = builder_->createVariable(
+        spv::NoPrecision, spv::StorageClassFunction,
+        builder_->makeArrayType(
+            builder_->makeArrayType(
+                type_float_, builder_->makeUintConstant(rect_clip_distance_count_), 0),
+            const_uint_3, 0),
+        "xe_var_rect_clip_distances");
+  }
+  if (rect_cull_distance_count_) {
+    var_main_rect_cull_distances_ = builder_->createVariable(
+        spv::NoPrecision, spv::StorageClassFunction,
+        builder_->makeArrayType(
+            builder_->makeArrayType(
+                type_float_, builder_->makeUintConstant(rect_cull_distance_count_), 0),
+            const_uint_3, 0),
+        "xe_var_rect_cull_distances");
+  }
+
+  // for (pass = 0; pass < 3; ++pass), as a loop whose continue block checks.
+  rect_pass_header_ = &builder_->makeNewBlock();
+  spv::Block& rect_pass_body = builder_->makeNewBlock();
+  rect_pass_continue_ = new spv::Block(builder_->getUniqueId(), *function_main_);
+  rect_pass_merge_ = new spv::Block(builder_->getUniqueId(), *function_main_);
+  builder_->createBranch(rect_pass_header_);
+  builder_->setBuildPoint(rect_pass_header_);
+  uint_vector_temp_.clear();
+  builder_->createLoopMerge(rect_pass_merge_, rect_pass_continue_,
+                            spv::LoopControlDontUnrollMask, uint_vector_temp_);
+  builder_->createBranch(&rect_pass_body);
+  builder_->setBuildPoint(&rect_pass_body);
+  ResetStateForRectangleListPass();
+}
+
+void SpirvShaderTranslator::ResetStateForRectangleListPass() {
+  // The values the variables are declared with, for every pass.
+  builder_->createStore(builder_->makeBoolConstant(false), var_main_predicate_);
+  builder_->createStore(const_uint4_0_, var_main_loop_count_);
+  builder_->createStore(const_int_0_, var_main_address_register_);
+  builder_->createStore(const_int4_0_, var_main_loop_address_);
+  builder_->createStore(const_float_0_, var_main_previous_scalar_);
+  builder_->createStore(const_int_0_, var_main_vfetch_address_);
+  builder_->createStore(const_int_0_, var_main_vfetch_bound_);
+  builder_->createStore(const_float_0_, var_main_tfetch_lod_);
+  builder_->createStore(const_float3_0_, var_main_tfetch_gradients_h_);
+  builder_->createStore(const_float3_0_, var_main_tfetch_gradients_v_);
+  if (var_main_memexport_address_ != spv::NoResult) {
+    builder_->createStore(const_float4_0_, var_main_memexport_address_);
+  }
+  for (spv::Id memexport_data : var_main_memexport_data_) {
+    if (memexport_data != spv::NoResult) {
+      builder_->createStore(const_float4_0_, memexport_data);
+    }
+  }
+  if (var_main_memexport_data_written_ != spv::NoResult) {
+    builder_->createStore(const_uint_0_, var_main_memexport_data_written_);
+  }
+}
+
+void SpirvShaderTranslator::CloseRectangleListPasses() {
+  // Keep this pass's outputs.
+  spv::Id pass = builder_->createUnaryOp(
+      spv::OpBitcast, type_int_,
+      builder_->createLoad(var_main_rect_pass_, spv::NoPrecision));
+  auto output_member = [&](unsigned int member) {
+    id_vector_temp_.clear();
+    id_vector_temp_.push_back(builder_->makeIntConstant(int(member)));
+    return builder_->createAccessChain(spv::StorageClassOutput,
+                                       output_per_vertex_, id_vector_temp_);
+  };
+  auto keep = [&](spv::Id output_pointer, spv::Id array) {
+    spv::Id value = builder_->createLoad(output_pointer, spv::NoPrecision);
+    id_vector_temp_.clear();
+    id_vector_temp_.push_back(pass);
+    builder_->createStore(
+        value, builder_->createAccessChain(spv::StorageClassFunction, array,
+                                           id_vector_temp_));
+  };
+  keep(output_member(kOutputPerVertexMemberPosition), var_main_rect_positions_);
+  for (size_t i = 0; i < var_main_rect_interpolators_.size(); ++i) {
+    if (var_main_rect_interpolators_[i] != spv::NoResult) {
+      keep(input_output_interpolators_[i], var_main_rect_interpolators_[i]);
+    }
+  }
+  if (var_main_rect_clip_distances_ != spv::NoResult) {
+    keep(output_member(output_per_vertex_clip_distance_member_index_),
+         var_main_rect_clip_distances_);
+  }
+  if (var_main_rect_cull_distances_ != spv::NoResult) {
+    keep(output_member(output_per_vertex_cull_distance_member_index_),
+         var_main_rect_cull_distances_);
+  }
+
+  // Next pass, or leave after the third.
+  builder_->createBranch(rect_pass_continue_);
+  function_main_->addBlock(rect_pass_continue_);
+  builder_->setBuildPoint(rect_pass_continue_);
+  spv::Id next_pass = builder_->createBinOp(
+      spv::OpIAdd, type_uint_,
+      builder_->createLoad(var_main_rect_pass_, spv::NoPrecision),
+      builder_->makeUintConstant(1));
+  builder_->createStore(next_pass, var_main_rect_pass_);
+  builder_->createConditionalBranch(
+      builder_->createBinOp(spv::OpULessThan, type_bool_, next_pass,
+                            builder_->makeUintConstant(3)),
+      rect_pass_header_, rect_pass_merge_);
+  function_main_->addBlock(rect_pass_merge_);
+  builder_->setBuildPoint(rect_pass_merge_);
+
+  // Choose the strip order from the longest edge, as the geometry shader does:
+  // [0] - 12, [1] - 20, [2] - 01; strip 0123, 1203 or 2013.
+  spv::Id positions[3];
+  for (int i = 0; i < 3; ++i) {
+    id_vector_temp_.clear();
+    id_vector_temp_.push_back(builder_->makeIntConstant(i));
+    positions[i] = builder_->createLoad(
+        builder_->createAccessChain(spv::StorageClassFunction,
+                                    var_main_rect_positions_, id_vector_temp_),
+        spv::NoPrecision);
+  }
+  spv::Id edge_lengths[3];
+  for (int i = 0; i < 3; ++i) {
+    spv::Id edge_0 = positions[(1 + i) % 3];
+    spv::Id edge_1 = positions[(2 + i) % 3];
+    spv::Id edge_x = builder_->createBinOp(
+        spv::OpFSub, type_float_,
+        builder_->createCompositeExtract(edge_1, type_float_, 0),
+        builder_->createCompositeExtract(edge_0, type_float_, 0));
+    spv::Id edge_y = builder_->createBinOp(
+        spv::OpFSub, type_float_,
+        builder_->createCompositeExtract(edge_1, type_float_, 1),
+        builder_->createCompositeExtract(edge_0, type_float_, 1));
+    edge_lengths[i] = builder_->createBinOp(
+        spv::OpFAdd, type_float_,
+        builder_->createBinOp(spv::OpFMul, type_float_, edge_x, edge_x),
+        builder_->createBinOp(spv::OpFMul, type_float_, edge_y, edge_y));
+  }
+  spv::Id const_int_1 = builder_->makeIntConstant(1);
+  spv::Id const_int_2 = builder_->makeIntConstant(2);
+  spv::Id const_int_3 = builder_->makeIntConstant(3);
+  spv::Id vertex_indices[3];
+  vertex_indices[0] = builder_->createTriOp(
+      spv::OpSelect, type_int_,
+      builder_->createBinOp(
+          spv::OpLogicalAnd, type_bool_,
+          builder_->createBinOp(spv::OpFOrdGreaterThan, type_bool_,
+                                edge_lengths[0], edge_lengths[1]),
+          builder_->createBinOp(spv::OpFOrdGreaterThan, type_bool_,
+                                edge_lengths[0], edge_lengths[2])),
+      const_int_0_,
+      builder_->createTriOp(
+          spv::OpSelect, type_int_,
+          builder_->createBinOp(spv::OpFOrdGreaterThan, type_bool_,
+                                edge_lengths[1], edge_lengths[2]),
+          const_int_1, const_int_2));
+  for (int i = 1; i < 3; ++i) {
+    spv::Id unwrapped = builder_->createBinOp(spv::OpIAdd, type_int_,
+                                              vertex_indices[0],
+                                              builder_->makeIntConstant(i));
+    vertex_indices[i] = builder_->createTriOp(
+        spv::OpSelect, type_int_,
+        builder_->createBinOp(spv::OpSLessThan, type_bool_, unwrapped,
+                              const_int_3),
+        unwrapped,
+        builder_->createBinOp(spv::OpISub, type_int_, unwrapped, const_int_3));
+  }
+
+  // This host vertex's corner of the strip.
+  spv::Id corner = builder_->createBinOp(
+      spv::OpBitwiseAnd, type_uint_,
+      builder_->createUnaryOp(
+          spv::OpBitcast, type_uint_,
+          builder_->createLoad(input_vertex_index_, spv::NoPrecision)),
+      builder_->makeUintConstant(3));
+  spv::Id corner_is_3 = builder_->createBinOp(
+      spv::OpIEqual, type_bool_, corner, builder_->makeUintConstant(3));
+  // The kept vertex for corners 0-2 (corner 3 is computed).
+  spv::Id kept_index = builder_->createTriOp(
+      spv::OpSelect, type_int_,
+      builder_->createBinOp(spv::OpIEqual, type_bool_, corner, const_uint_0_),
+      vertex_indices[0],
+      builder_->createTriOp(
+          spv::OpSelect, type_int_,
+          builder_->createBinOp(spv::OpIEqual, type_bool_, corner,
+                                builder_->makeUintConstant(1)),
+          vertex_indices[1], vertex_indices[2]));
+
+  // value = corner 3 ? v1 - v0 + v2 : v[kept], from an array of 3 kept values
+  // (indices are the element path below the pass index).
+  auto corner_value = [&](spv::Id array, spv::Id type, spv::Id type_bool,
+                          int element) {
+    auto load = [&](spv::Id index) {
+      id_vector_temp_.clear();
+      id_vector_temp_.push_back(index);
+      if (element >= 0) {
+        id_vector_temp_.push_back(builder_->makeIntConstant(element));
+      }
+      return builder_->createLoad(
+          builder_->createAccessChain(spv::StorageClassFunction, array,
+                                      id_vector_temp_),
+          spv::NoPrecision);
+    };
+    spv::Id v0 = load(vertex_indices[0]);
+    spv::Id v1 = load(vertex_indices[1]);
+    spv::Id v2 = load(vertex_indices[2]);
+    spv::Id v3 = builder_->createNoContractionBinOp(
+        spv::OpFAdd, type,
+        builder_->createNoContractionBinOp(spv::OpFSub, type, v1, v0), v2);
+    spv::Id kept = load(kept_index);
+    spv::Id condition = type_bool == type_bool_
+                            ? corner_is_3
+                            : builder_->smearScalar(spv::NoPrecision,
+                                                    corner_is_3, type_bool);
+    return builder_->createTriOp(spv::OpSelect, type, condition, v3, kept);
+  };
+
+  builder_->createStore(
+      corner_value(var_main_rect_positions_, type_float4_, type_bool4_, -1),
+      output_member(kOutputPerVertexMemberPosition));
+  for (size_t i = 0; i < var_main_rect_interpolators_.size(); ++i) {
+    if (var_main_rect_interpolators_[i] != spv::NoResult) {
+      builder_->createStore(corner_value(var_main_rect_interpolators_[i],
+                                         type_float4_, type_bool4_, -1),
+                            input_output_interpolators_[i]);
+    }
+  }
+  auto distances = [&](spv::Id array, uint32_t count, unsigned int member) {
+    for (uint32_t i = 0; i < count; ++i) {
+      spv::Id value = corner_value(array, type_float_, type_bool_, int(i));
+      id_vector_temp_.clear();
+      id_vector_temp_.push_back(builder_->makeIntConstant(int(member)));
+      id_vector_temp_.push_back(builder_->makeIntConstant(int(i)));
+      builder_->createStore(
+          value, builder_->createAccessChain(spv::StorageClassOutput,
+                                             output_per_vertex_,
+                                             id_vector_temp_));
+    }
+  };
+  if (var_main_rect_clip_distances_ != spv::NoResult) {
+    distances(var_main_rect_clip_distances_, rect_clip_distance_count_,
+              output_per_vertex_clip_distance_member_index_);
+  }
+  if (var_main_rect_cull_distances_ != spv::NoResult) {
+    distances(var_main_rect_cull_distances_, rect_cull_distance_count_,
+              output_per_vertex_cull_distance_member_index_);
+  }
+}
