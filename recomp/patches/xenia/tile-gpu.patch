diff --git a/src/xenia/gpu/vulkan/ips3_gpu_timing.h b/src/xenia/gpu/vulkan/ips3_gpu_timing.h
new file mode 100644
index 000000000..262d3c4a9
--- /dev/null
+++ b/src/xenia/gpu/vulkan/ips3_gpu_timing.h
@@ -0,0 +1,186 @@
+// Ips3: how long the host GPU spends on each kind of work Xenia records -- render passes,
+// compute dispatches (resolves, render target dumps, texture loads...), copies -- measured with
+// timestamps written whenever the kind of work changes (outside render passes only), read back
+// once the submission has finished. For the status lines; IPS3_GPU_TIMING=0 turns it off.
+#ifndef XENIA_GPU_VULKAN_IPS3_GPU_TIMING_H_
+#define XENIA_GPU_VULKAN_IPS3_GPU_TIMING_H_
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <unordered_map>
+#include <vector>
+
+#include "xenia/ui/vulkan/vulkan_device.h"
+#include "xenia/ui/vulkan/vulkan_instance.h"
+
+namespace ips3 {
+
+enum class GpuWork : uint8_t {
+  kOther,
+  kRenderPass,
+  kCompute,      // compute not tagged below
+  kDump,         // render targets into the EDRAM buffer (before resolves)
+  kResolve,      // EDRAM into guest memory (and resolve clears, downscales)
+  kTextureLoad,  // guest memory into host textures
+  kCopy,
+  kCount
+};
+
+class GpuTiming {
+ public:
+  static GpuTiming& Get() {
+    static GpuTiming timing;
+    return timing;
+  }
+
+  // Nanoseconds of GPU time per kind of work so far, and submissions whose timestamps were not
+  // ready when their query pool was needed again.
+  std::array<std::atomic<uint64_t>, size_t(GpuWork::kCount)> ns{};
+  std::atomic<uint64_t> lost{0};
+  std::atomic<bool> active{false};
+
+  // The kind of work of the compute pipeline the next BindExternalComputePipeline binds (set by
+  // its caller), and the kinds of the pipelines bound so far. Command processor thread only.
+  GpuWork next_compute_tag = GpuWork::kCompute;
+  void TagNextComputePipeline(VkPipeline pipeline) {
+    if (next_compute_tag != GpuWork::kCompute) {
+      tags_[pipeline] = next_compute_tag;
+    }
+    next_compute_tag = GpuWork::kCompute;
+  }
+  GpuWork ComputeTag(VkPipeline pipeline) const {
+    auto it = tags_.find(pipeline);
+    return it != tags_.end() ? it->second : GpuWork::kCompute;
+  }
+
+  // Called by the command processor's thread only.
+  void BeginCommandBuffer(const xe::ui::vulkan::VulkanDevice* device, VkCommandBuffer cb) {
+    if (!Init(device)) {
+      return;
+    }
+    Pool& pool = pools_[next_pool_];
+    next_pool_ = (next_pool_ + 1) % kPools;
+    if (pool.pending) {
+      Collect(pool);
+    }
+    current_ = &pool;
+    pool.count = 0;
+    pool.pending = true;
+    dfn_->vkCmdResetQueryPool(cb, pool.pool, 0, kQueries);
+    work_ = GpuWork::kOther;
+    Write(cb, GpuWork::kOther);
+  }
+
+  // Before work of the given kind is recorded (never inside a render pass).
+  void Switch(VkCommandBuffer cb, GpuWork work) {
+    if (current_ && work != work_) {
+      Write(cb, work);
+      work_ = work;
+    }
+  }
+
+  void EndCommandBuffer(VkCommandBuffer cb) {
+    if (current_) {
+      Write(cb, GpuWork::kOther);
+      current_ = nullptr;
+    }
+  }
+
+ private:
+  static constexpr uint32_t kPools = 8;
+  static constexpr uint32_t kQueries = 1024;
+
+  struct Pool {
+    VkQueryPool pool = VK_NULL_HANDLE;
+    uint32_t count = 0;
+    bool pending = false;
+    std::array<GpuWork, kQueries> work{};
+  };
+
+  bool Init(const xe::ui::vulkan::VulkanDevice* device) {
+    if (state_ != 0) {
+      return state_ == 1;
+    }
+    state_ = 2;
+    if (const char* setting = getenv("IPS3_GPU_TIMING"); setting && setting[0] == '0') {
+      return false;
+    }
+    const auto& ifn = device->vulkan_instance()->functions();
+    uint32_t family_count = 0;
+    ifn.vkGetPhysicalDeviceQueueFamilyProperties(device->physical_device(), &family_count,
+                                                 nullptr);
+    std::vector<VkQueueFamilyProperties> families(family_count);
+    ifn.vkGetPhysicalDeviceQueueFamilyProperties(device->physical_device(), &family_count,
+                                                 families.data());
+    const uint32_t family = device->queue_family_graphics_compute();
+    if (family >= family_count || !families[family].timestampValidBits) {
+      return false;
+    }
+    const uint32_t bits = families[family].timestampValidBits;
+    mask_ = bits >= 64 ? ~uint64_t(0) : (uint64_t(1) << bits) - 1;
+    VkPhysicalDeviceProperties properties;
+    ifn.vkGetPhysicalDeviceProperties(device->physical_device(), &properties);
+    period_ = properties.limits.timestampPeriod;
+    if (period_ <= 0.0f) {
+      return false;
+    }
+    dfn_ = &device->functions();
+    device_ = device->device();
+    VkQueryPoolCreateInfo create_info = {VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+    create_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    create_info.queryCount = kQueries;
+    for (Pool& pool : pools_) {
+      if (dfn_->vkCreateQueryPool(device_, &create_info, nullptr, &pool.pool) != VK_SUCCESS) {
+        return false;
+      }
+    }
+    state_ = 1;
+    active = true;
+    return true;
+  }
+
+  void Write(VkCommandBuffer cb, GpuWork work) {
+    if (current_->count >= kQueries) {
+      return;
+    }
+    current_->work[current_->count] = work;
+    dfn_->vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, current_->pool,
+                              current_->count);
+    ++current_->count;
+  }
+
+  void Collect(Pool& pool) {
+    pool.pending = false;
+    if (pool.count < 2) {
+      return;
+    }
+    std::array<uint64_t, kQueries> stamps;
+    if (dfn_->vkGetQueryPoolResults(device_, pool.pool, 0, pool.count,
+                                    sizeof(uint64_t) * pool.count, stamps.data(),
+                                    sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      ++lost;
+      return;
+    }
+    for (uint32_t i = 1; i < pool.count; ++i) {
+      const uint64_t ticks = (stamps[i] - stamps[i - 1]) & mask_;
+      ns[size_t(pool.work[i - 1])] += uint64_t(double(ticks) * period_);
+    }
+  }
+
+  int state_ = 0;  // 0 not yet, 1 on, 2 off
+  const xe::ui::vulkan::VulkanDevice::Functions* dfn_ = nullptr;
+  VkDevice device_ = VK_NULL_HANDLE;
+  uint64_t mask_ = 0;
+  float period_ = 0.0f;
+  std::array<Pool, kPools> pools_;
+  uint32_t next_pool_ = 0;
+  Pool* current_ = nullptr;
+  GpuWork work_ = GpuWork::kOther;
+  std::unordered_map<VkPipeline, GpuWork> tags_;
+};
+
+}  // namespace ips3
+
+#endif  // XENIA_GPU_VULKAN_IPS3_GPU_TIMING_H_
