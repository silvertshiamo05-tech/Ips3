+// Ips3: counts of the GPU work Xenia records, for the status lines (what each guest frame costs
+// the host GPU).
+#ifndef XENIA_GPU_IPS3_GPU_COUNTERS_H_
+#define XENIA_GPU_IPS3_GPU_COUNTERS_H_
+
+#include <atomic>
+#include <cstdint>
+
+struct Ips3GpuCounters {
+  std::atomic<uint64_t> render_passes{0};
+  std::atomic<uint64_t> render_pass_pixels{0};
+  std::atomic<uint64_t> msaa_render_passes{0};
+  std::atomic<uint64_t> draws{0};
+  std::atomic<uint64_t> dispatches{0};
+  std::atomic<uint64_t> copies{0};
+  std::atomic<uint64_t> barriers{0};
+  std::atomic<uint64_t> transfers{0};
+  std::atomic<uint64_t> resolves{0};
+  std::atomic<uint64_t> submissions{0};
+  std::atomic<uint64_t> dumps{0};
+  std::atomic<uint64_t> dumps_skipped{0};
+};
+
+inline Ips3GpuCounters ips3_gpu_counters;
+
+#endif  // XENIA_GPU_IPS3_GPU_COUNTERS_H_
